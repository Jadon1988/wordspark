{
  "id": "/wordspark/",
  "name": "WordSpark — Learn English Vocabulary",
  "short_name": "WordSpark",
  "description": "Learn English words that actually stick — through games, daily practice, and a friendly AI tutor.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F1ECFF",
  "theme_color": "#6D40F0",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "games"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/home.png", "sizes": "1080x2130", "type": "image/png", "form_factor": "narrow", "label": "Build a daily learning streak" },
    { "src": "screenshots/emily.png", "sizes": "1080x2130", "type": "image/png", "form_factor": "narrow", "label": "Chat with Emily, your AI English tutor" },
    { "src": "screenshots/monster.png", "sizes": "1080x2130", "type": "image/png", "form_factor": "narrow", "label": "Battle monsters in the Gauntlet" },
    { "src": "screenshots/flashcard.png", "sizes": "1080x2130", "type": "image/png", "form_factor": "narrow", "label": "Learn words through quick games" },
    { "src": "screenshots/fill-blank.png", "sizes": "1080x2130", "type": "image/png", "form_factor": "narrow", "label": "Fill-in-the-blank practice" },
    { "src": "screenshots/word-of-the-day.png", "sizes": "1080x2130", "type": "image/png", "form_factor": "narrow", "label": "A new word every day" }
  ]
}
